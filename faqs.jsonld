      "item": {
        "url": "aeoptimizer.com/faq/is-it-really-worth-spending-time-on-siri-visibility-or-is-it-just-a-nice-to-have",
        "name": "Is it really worth spending time on Siri visibility, or is it just a nice-to-have?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
