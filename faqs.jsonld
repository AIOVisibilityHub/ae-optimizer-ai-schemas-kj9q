        "url": "aeoptimizer.com/faq/how-is-ai-visibility-different-from-traditional-seo-visibility",
        "name": "How is AI visibility different from traditional SEO visibility?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
