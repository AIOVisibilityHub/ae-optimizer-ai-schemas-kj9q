      "item": {
        "url": "aeoptimizer.com/faq/is-it-safe-to-use-ai-generated-content-if-i-want-to-rank-in-and-be-cited-by-ai-o",
        "name": "Is it safe to use AI-generated content if I want to rank in and be cited by AI overviews?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
