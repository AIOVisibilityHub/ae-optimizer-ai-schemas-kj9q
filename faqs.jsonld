      "item": {
        "url": "aeoptimizer.com/faq/what-should-i-look-for-when-picking-an-agency-or-consultant-to-help-with-llmo-st",
        "name": "What should I look for when picking an agency or consultant to help with LLMO strategy?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
