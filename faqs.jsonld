        "@type": "FAQPage",
        "@context": "https://schema.org",
        "mainEntity": [
          {
            "name": "What are AI Visibility Files?",
            "@type": "Question",
            "acceptedAnswer": {
              "text": "AI Visibility Files are a collection of machine-readable files and structured data designed specifically for AI models. This includes JSON-LD structured data, llms.txt, ai-plugin.json, ai-sitemap.xml, FAQPage schema, Knowledge Graph files, and help articles formatted for RAG systems and LLM ingestion. These files tell AI exactly who you are, what you do, and where you serve, enabling them to confidently cite your business.",
              "@type": "Answer"
            }
          }
        ],
