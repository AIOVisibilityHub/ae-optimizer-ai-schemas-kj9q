      "item": {
        "url": "aeoptimizer.com/faq/what-should-i-do-if-an-llm-cites-the-wrong-source-or-clearly-misattributes-infor",
        "name": "What should I do if an LLM cites the wrong source or clearly misattributes information?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
