      "item": {
        "url": "aeoptimizer.com/faq/how-important-is-zero-click-visibility-for-local-businesses-in-cities-like-los-a",
        "name": "How important is zero-click visibility for local businesses in cities like Los Angeles or San Diego?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
