      "item": {
        "url": "aeoptimizer.com/faq/how-many-conversational-keywords-should-i-start-with-and-how-often-should-i-upda",
        "name": "How many conversational keywords should I start with, and how often should I update them?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
