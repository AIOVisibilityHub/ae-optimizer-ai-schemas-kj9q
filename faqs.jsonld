      "item": {
        "url": "aeoptimizer.com/faq/how-do-i-actually-get-my-website-to-show-up-in-perplexity-answers-not-just-its-s",
        "name": "How do I actually get my website to show up in Perplexity answers, not just its search results?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
