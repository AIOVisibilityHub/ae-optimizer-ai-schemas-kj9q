      "item": {
        "url": "aeoptimizer.com/faq/why-don-t-ai-tools-mention-my-brand-even-though-my-seo-rankings-look-good",
        "name": "Why don’t AI tools mention my brand even though my SEO rankings look good?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
