      "item": {
        "url": "aeoptimizer.com/faq/how-can-i-tell-if-my-voice-search-optimization-is-actually-working-and-not-just",
        "name": "How can I tell if my voice search optimization is actually working and not just changing things on paper?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
