      "item": {
        "url": "aeoptimizer.com/faq/does-speakable-schema-actually-help-my-seo-rankings-or-is-it-just-hype",
        "name": "Does speakable schema actually help my SEO rankings or is it just hype?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
