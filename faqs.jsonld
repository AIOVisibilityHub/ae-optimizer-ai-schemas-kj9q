        "url": "aeoptimizer.com/faq/how-do-i-know-if-my-ai-citations-are-actually-worth-anything-for-my-business-or",
        "name": "How do I know if my AI citations are actually worth anything for my business, or just vanity metrics?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
