      "item": {
        "url": "aeoptimizer.com/faq/how-should-a-small-business-with-a-tight-budget-approach-question-based-keyword",
        "name": "How should a small business with a tight budget approach question-based keyword SEO?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
