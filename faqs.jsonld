      "item": {
        "url": "aeoptimizer.com/faq/what-should-i-focus-on-first-if-i-want-to-show-up-in-google-ai-overviews-but-i-h",
        "name": "What should I focus on first if I want to show up in Google AI Overviews but I have a really limited SEO budget?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
