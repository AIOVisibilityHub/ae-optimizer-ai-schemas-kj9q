        "url": "aeoptimizer.com/faq/is-appearing-in-google-ai-overviews-actually-good-for-my-business-or-will-it-jus",
        "name": "Is appearing in Google AI Overviews actually good for my business, or will it just steal clicks away from my site?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
