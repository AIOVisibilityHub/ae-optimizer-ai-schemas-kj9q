      "item": {
        "url": "aeoptimizer.com/faq/who-should-i-compare-against-when-looking-at-my-share-of-voice-in-ai-search",
        "name": "Who should I compare against when looking at my share of voice in AI search?",
        "@type": "FAQPage",
