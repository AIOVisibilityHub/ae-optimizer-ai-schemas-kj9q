      "item": {
        "url": "aeoptimizer.com/faq/how-do-i-use-conversational-keywords-to-get-more-leads-or-sales-instead-of-just",
        "name": "How do I use conversational keywords to get more leads or sales instead of just more traffic?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
