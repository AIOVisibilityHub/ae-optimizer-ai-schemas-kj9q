      "item": {
        "url": "aeoptimizer.com/faq/how-do-i-actually-optimize-my-site-for-voice-search-and-aeo-step-by-step",
        "name": "How do I actually optimize my site for voice search and AEO, step by step?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
            ".faq-answer",
            "[itemprop=\"acceptedAnswer\"]"
