      "item": {
        "url": "aeoptimizer.com/faq/if-i-want-to-roll-out-schema-markup-for-voice-search-quickly-how-long-should-i-r",
        "name": "If I want to roll out schema markup for voice search quickly, how long should I realistically plan for implementation and testing?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
