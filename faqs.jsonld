        "url": "aeoptimizer.com/faq/how-can-i-tell-if-my-schema-markup-is-actually-improving-my-voice-search-perform",
        "name": "How can I tell if my schema markup is actually improving my voice search performance and not just sitting there?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
