      "item": {
        "url": "aeoptimizer.com/faq/how-does-llm-citation-tracking-actually-work-step-by-step-from-prompts-to-report",
        "name": "How does LLM citation tracking actually work step by step, from prompts to reports?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
