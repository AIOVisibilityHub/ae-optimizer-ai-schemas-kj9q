      "item": {
        "url": "aeoptimizer.com/faq/how-is-optimizing-for-ai-citations-different-from-regular-seo-and-do-i-have-to-c",
        "name": "How is optimizing for AI citations different from regular SEO, and do I have to choose between them?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
