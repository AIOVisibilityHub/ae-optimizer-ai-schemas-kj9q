      "item": {
        "url": "aeoptimizer.com/faq/why-does-cortana-voice-search-keep-saying-i-m-offline-when-my-internet-works-fin",
        "name": "Why does Cortana voice search keep saying I’m offline when my internet works fine?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
            ".faq-answer",
            "[itemprop=\"acceptedAnswer\"]"
