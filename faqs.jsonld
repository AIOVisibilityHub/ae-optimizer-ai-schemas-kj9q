        "url": "aeoptimizer.com/faq/can-getting-cited-by-ai-backfire-on-my-brand-like-having-my-content-misquoted-ov",
        "name": "Can getting cited by AI backfire on my brand, like having my content misquoted, oversimplified, or used in the wrong context?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
