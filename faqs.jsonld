      "item": {
        "url": "aeoptimizer.com/faq/how-can-i-connect-ai-citation-tracking-with-leads-and-revenue-not-just-visibilit",
        "name": "How can I connect AI citation tracking with leads and revenue, not just visibility metrics?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
            ".faq-answer",
