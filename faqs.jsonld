        "url": "aeoptimizer.com/faq/how-can-i-tell-which-question-based-keywords-my-site-already-ranks-for-and-where",
        "name": "How can I tell which question-based keywords my site already ranks for and where the gaps are?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
