      "item": {
        "url": "aeoptimizer.com/faq/how-does-a-help-center-or-knowledge-base-serve-as-a-good-answer-engine-optimizat",
        "name": "How does a help center or knowledge base serve as a good answer engine optimization example?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
