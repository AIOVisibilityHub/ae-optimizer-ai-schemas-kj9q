      "item": {
        "url": "aeoptimizer.com/faq/can-per-page-json-ld-get-my-site-penalized-if-i-push-too-hard-for-rich-results",
        "name": "Can per-page JSON-LD get my site penalized if I push too hard for rich results?",
        "@type": "FAQPage",
