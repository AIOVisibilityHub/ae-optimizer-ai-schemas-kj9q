      "item": {
        "url": "aeoptimizer.com/faq/what-can-i-do-if-ai-summaries-or-google-panels-describe-my-business-incorrectly",
        "name": "What can I do if AI summaries or Google panels describe my business incorrectly?",
        "@type": "FAQPage",
