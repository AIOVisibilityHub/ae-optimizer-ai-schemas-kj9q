      "item": {
        "url": "aeoptimizer.com/faq/how-often-do-i-need-to-update-my-content-if-i-want-google-ai-overviews-to-keep-t",
        "name": "How often do I need to update my content if I want Google AI Overviews to keep trusting and citing my site?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
