        "url": "aeoptimizer.com/faq/what-if-my-organic-traffic-goes-down-while-my-zero-click-visibility-goes-up-shou",
        "name": "What if my organic traffic goes down while my zero-click visibility goes up—should I be worried?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
