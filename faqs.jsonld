      "item": {
        "url": "aeoptimizer.com/faq/do-llm-citations-actually-help-with-conversions-or-are-they-just-a-visibility-me",
        "name": "Do LLM citations actually help with conversions or are they just a visibility metric?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
