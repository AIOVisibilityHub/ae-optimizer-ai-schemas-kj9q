        "url": "aeoptimizer.com/faq/what-s-the-simplest-way-to-start-tracking-ai-citations-for-my-brand-without-buyi",
        "name": "What’s the simplest way to start tracking AI citations for my brand without buying a tool?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
            ".faq-answer",
