        "url": "aeoptimizer.com/faq/how-do-i-get-alexa-to-mention-my-name-or-brand-when-people-talk-to-her",
        "name": "How do I get Alexa to mention my name or brand when people talk to her?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
