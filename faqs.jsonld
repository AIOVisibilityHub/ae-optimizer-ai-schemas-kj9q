      "item": {
        "url": "aeoptimizer.com/faq/i-ve-had-a-bad-seo-experience-before-how-is-zero-click-visibility-any-different",
        "name": "I’ve had a bad SEO experience before—how is zero-click visibility any different?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
