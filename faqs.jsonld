      "item": {
        "url": "aeoptimizer.com/faq/is-speakable-schema-actually-useful-for-local-content-in-cities-like-los-angeles",
        "name": "Is speakable schema actually useful for local content in cities like Los Angeles or Austin?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
