        "url": "aeoptimizer.com/faq/how-do-i-know-if-my-geo-strategy-is-actually-working-what-should-i-be-measuring",
        "name": "How do I know if my GEO strategy is actually working—what should I be measuring?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
