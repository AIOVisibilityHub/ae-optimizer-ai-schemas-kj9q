        "url": "aeoptimizer.com/faq/do-you-have-to-be-a-big-authoritative-site-to-get-listed-in-google-ai-overviews",
        "name": "Do you have to be a big, authoritative site to get listed in Google AI Overviews, or can smaller niche sites show up too?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
