      "item": {
        "url": "aeoptimizer.com/faq/do-i-need-structured-data-on-every-page-for-aeo-or-just-the-important-ones",
        "name": "Do I need structured data on every page for AEO, or just the important ones?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
            ".faq-answer",
            "[itemprop=\"acceptedAnswer\"]"
