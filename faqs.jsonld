        "url": "aeoptimizer.com/faq/how-important-is-structured-data-schema-for-brand-authority-in-ai-search-and-wha",
        "name": "How important is structured data (schema) for brand authority in AI search, and what should we implement first?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
