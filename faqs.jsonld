        "url": "aeoptimizer.com/faq/how-do-i-know-if-my-generative-ai-search-optimization-efforts-are-actually-worki",
        "name": "How do I know if my generative AI search optimization efforts are actually working?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
