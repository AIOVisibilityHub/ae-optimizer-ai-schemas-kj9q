      "item": {
        "url": "aeoptimizer.com/faq/with-limited-time-which-prompts-should-i-prioritize-for-llm-citation-tracking-so",
        "name": "With limited time, which prompts should I prioritize for LLM citation tracking so it actually impacts revenue?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
