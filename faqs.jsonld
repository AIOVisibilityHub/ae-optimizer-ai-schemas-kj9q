      "item": {
        "url": "aeoptimizer.com/faq/what-s-the-best-way-to-structure-and-store-my-ai-citation-tracking-data-so-it-do",
        "name": "What’s the best way to structure and store my AI citation tracking data so it doesn’t become a mess?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
