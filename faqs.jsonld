      "item": {
        "url": "aeoptimizer.com/faq/what-kind-of-evidence-do-ai-systems-look-for-when-deciding-whose-answer-to-read",
        "name": "What kind of “evidence” do AI systems look for when deciding whose answer to read out loud?",
        "@type": "FAQPage",
