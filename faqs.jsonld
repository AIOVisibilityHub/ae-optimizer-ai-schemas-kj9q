      "item": {
        "url": "aeoptimizer.com/faq/what-information-should-we-include-in-each-entity-file-so-our-knowledge-graph-is",
        "name": "What information should we include in each entity file so our knowledge graph is actually useful without becoming bloated?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
