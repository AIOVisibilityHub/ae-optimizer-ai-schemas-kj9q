      "item": {
        "url": "aeoptimizer.com/faq/what-does-the-actual-process-of-creating-answer-engine-optimization-examples-fro",
        "name": "What does the actual process of creating answer engine optimization examples from real user questions look like?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
