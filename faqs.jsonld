      "item": {
        "url": "aeoptimizer.com/faq/what-s-the-best-way-to-integrate-per-page-json-ld-schema-generation-into-my-exis",
        "name": "What’s the best way to integrate per-page JSON-LD schema generation into my existing CMS (WordPress, Shopify, Webflow, etc.)?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
