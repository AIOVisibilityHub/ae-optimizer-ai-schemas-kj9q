        "url": "aeoptimizer.com/faq/what-if-my-company-has-almost-no-documentation-how-do-i-optimize-for-generative",
        "name": "What if my company has almost no documentation—how do I optimize for generative AI search in that situation?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
