      "item": {
        "url": "aeoptimizer.com/faq/what-can-i-do-if-llm-citation-tracking-shows-that-ai-models-are-describing-my-br",
        "name": "What can I do if LLM citation tracking shows that AI models are describing my brand incorrectly or using outdated info?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
