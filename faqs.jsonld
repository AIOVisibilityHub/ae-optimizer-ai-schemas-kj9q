      "item": {
        "url": "aeoptimizer.com/faq/what-s-the-very-first-thing-i-should-do-if-i-want-to-get-serious-about-alexa-opt",
        "name": "What’s the very first thing I should do if I want to get serious about Alexa optimization?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
