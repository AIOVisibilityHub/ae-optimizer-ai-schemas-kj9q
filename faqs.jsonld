      "item": {
        "url": "aeoptimizer.com/faq/how-do-i-know-if-my-alexa-optimization-is-actually-working-or-just-wasting-time",
        "name": "How do I know if my Alexa optimization is actually working or just wasting time?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
