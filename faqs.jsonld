        "url": "aeoptimizer.com/faq/what-does-a-serious-knowledge-graph-and-entity-file-project-usually-cost-and-wha",
        "name": "What does a serious knowledge graph and entity file project usually cost, and what actually drives the price up or down?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
