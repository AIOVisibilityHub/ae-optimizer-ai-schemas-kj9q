      "item": {
        "url": "aeoptimizer.com/faq/why-are-my-newer-better-articles-still-not-being-cited-by-ai-even-though-i-wrote",
        "name": "Why are my newer, better articles still not being cited by AI, even though I wrote them specifically for that purpose?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
