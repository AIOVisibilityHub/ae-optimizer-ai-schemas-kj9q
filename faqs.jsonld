      "item": {
        "url": "aeoptimizer.com/faq/do-i-have-to-create-all-new-content-for-ai-overviews-or-can-i-just-rework-what-i",
        "name": "Do I have to create all-new content for AI overviews, or can I just rework what I already have?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
