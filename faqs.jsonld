      "item": {
        "url": "aeoptimizer.com/faq/should-i-try-to-track-ai-citations-myself-or-hire-someone-or-buy-a-tool-to-do-it",
        "name": "Should I try to track AI citations myself or hire someone or buy a tool to do it for me?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
