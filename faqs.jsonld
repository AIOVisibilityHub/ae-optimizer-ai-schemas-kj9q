        "url": "aeoptimizer.com/faq/what-should-we-do-if-our-aeo-changes-aren-t-showing-up-in-chatgpt-or-perplexity",
        "name": "What should we do if our AEO changes aren’t showing up in ChatGPT or Perplexity answers yet?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
