        "url": "aeoptimizer.com/faq/how-do-i-actually-get-my-local-business-to-show-up-when-people-use-voice-search",
        "name": "How do I actually get my local business to show up when people use voice search like “Hey Google, find this near me”?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
