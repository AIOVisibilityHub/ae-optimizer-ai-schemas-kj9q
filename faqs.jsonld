      "item": {
        "url": "aeoptimizer.com/faq/what-information-do-i-actually-need-to-give-an-ai-tool-so-it-can-generate-accura",
        "name": "What information do I actually need to give an AI tool so it can generate accurate citations instead of making stuff up?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
