      "item": {
        "url": "aeoptimizer.com/faq/how-does-optimizing-for-ai-overviews-change-my-overall-seo-and-content-strategy",
        "name": "How does optimizing for AI overviews change my overall SEO and content strategy long term?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
