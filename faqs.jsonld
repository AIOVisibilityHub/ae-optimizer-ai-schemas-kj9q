      "item": {
        "url": "aeoptimizer.com/faq/what-is-generative-engine-optimization-in-plain-english",
        "name": "What is generative engine optimization, in plain English?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
