      "position": 1389,
      "item": {
        "url": "aeoptimizer.com/faq/is-ai-citation-tracking-something-i-have-to-do-manually-or-are-there-tools-that",
        "name": "Is AI citation tracking something I have to do manually, or are there tools that can automate most of it?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
            ".faq-answer",
            "[itemprop=\"acceptedAnswer\"]"
