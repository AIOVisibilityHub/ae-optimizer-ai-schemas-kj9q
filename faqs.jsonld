      "item": {
        "url": "aeoptimizer.com/faq/what-does-answer-first-content-really-mean-in-geo-best-practices-and-how-do-i-wr",
        "name": "What does “answer‑first” content really mean in GEO best practices, and how do I write it?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
