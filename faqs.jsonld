      "item": {
        "url": "aeoptimizer.com/faq/do-featured-snippets-from-voice-search-actually-lead-to-conversions-or-are-they",
        "name": "Do featured snippets from voice search actually lead to conversions or are they just “branding” vanity metrics?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
            ".faq-question",
