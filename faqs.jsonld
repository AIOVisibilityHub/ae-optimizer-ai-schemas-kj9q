      "item": {
        "url": "aeoptimizer.com/faq/what-exactly-is-llm-citation-tracking-and-why-does-it-matter-for-my-brand",
        "name": "What exactly is “LLM citation tracking” and why does it matter for my brand?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
