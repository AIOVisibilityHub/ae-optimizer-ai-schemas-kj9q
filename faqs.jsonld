      "item": {
        "url": "aeoptimizer.com/faq/what-s-the-best-way-to-structure-a-page-so-ai-overviews-actually-use-my-content",
        "name": "What’s the best way to structure a page so AI overviews actually use my content?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
