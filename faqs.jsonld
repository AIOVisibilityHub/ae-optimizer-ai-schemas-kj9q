      "item": {
        "url": "aeoptimizer.com/faq/i-ve-seen-llms-hallucinate-citations-before-how-do-i-reduce-bad-or-fake-citation",
        "name": "I’ve seen LLMs hallucinate citations before—how do I reduce bad or fake citations?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
            "h1",
