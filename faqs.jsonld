        "url": "aeoptimizer.com/faq/what-should-we-do-if-our-ai-visibility-suddenly-drops-or-answers-turn-negative",
        "name": "What should we do if our AI visibility suddenly drops or answers turn negative?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
