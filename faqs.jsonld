      "item": {
        "url": "aeoptimizer.com/faq/when-is-it-better-to-use-spoken-search-queries-instead-of-typing-and-when-is-it",
        "name": "When is it better to use spoken search queries instead of typing, and when is it worse?",
        "@type": "FAQPage",
