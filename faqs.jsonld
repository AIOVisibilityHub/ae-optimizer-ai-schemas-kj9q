      "item": {
        "url": "aeoptimizer.com/faq/what-are-the-biggest-content-mistakes-that-cause-ai-overviews-to-choose-my-compe",
        "name": "What are the biggest content mistakes that cause AI overviews to choose my competitors instead of me?",
        "@type": "FAQPage",
        "@context": "https://schema.org",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [
